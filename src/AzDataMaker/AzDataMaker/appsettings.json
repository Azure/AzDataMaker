{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  //override this settings in "user screts" during development, or with an environment variable in production

  // How many files should we create
  "FileCount": 25,

  // Max File Size (in MB)
  "MaxFileSize": 5,

  // Min File Size (in MB)
  "MinFileSize": 1,

  // How often should I log progress on the upload (in num of files)?
  "ReportStatusIncrement": 10,

  // Containers to upload to. Enter either a int count for random container names, or a comma seperated list of container names.
  "BlobContainers": 5,

  //Randomize File Contents (true/false)
  "RandomFileContents": false,

  // Option 1: Connection string authentication (provide the full connection string)
  "ConnectionStrings": {
    "MyStorageConnection": ""
  },

  // Option 2: Managed Identity authentication (provide only the storage account endpoint URI)
  // Example: "https://<acctname>.blob.core.windows.net/"
  // When set, DefaultAzureCredential is used (supports Managed Identity in ACI, and local dev credentials)
  "StorageAccountUri": ""
}
